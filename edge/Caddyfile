{
	email {$ACME_EMAIL}
}

# Shared by every site snippet (`import common`).
# TLS, HTTP/2, HTTP/3 and HTTP->HTTPS redirects are automatic.
(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# One file per site, generated by `prm new`.
import /etc/caddy/sites/*.caddy
