#!/usr/bin/env bash
# prm - run several small LEMP sites on one VPS.
#   prm new <site> <domain[,domain...]> [--type generic|drupal|headless|spa] [--size small|medium|large] [--example hello]
#   prm demo <name>                     throwaway Drupal site on <name>.localhost, installed and serving
#   prm ls
#   prm all <command> [args]            run a site command against every site
#   prm update                          pull new base images, rebuild and restart every site
#   prm migrate <site> <domains> --code <dir> --db <dump> [--files <dir>]   import an existing site
#   prm edge up|down|reload|logs|ps
#   prm <site> up|down|restart|ps|logs|deploy|backup|restore <file>|sh|exec|compose ...
#   prm <site> composer|drush|npm|npx ...
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
SITES_DIR="${PRM_SITES_DIR:-$ROOT/sites}"
STACK="$ROOT/stack/compose.yaml"
HARDENED="$ROOT/stack/compose.hardened.yaml"
EDGE_DIR="$ROOT/edge"
DEMO_PASS="${PRM_DEMO_PASS:-admin}" # `prm demo` only; never used by a real site

die()  { echo "prm: $*" >&2; exit 1; }
info() { echo "==> $*" >&2; }

command -v docker >/dev/null || die "docker not found"
docker compose version >/dev/null 2>&1 || die "docker compose v2 plugin not found"

edge_network() { echo "${EDGE_NETWORK:-edge}"; }
ensure_network() {
  local n; n="$(edge_network)"
  docker network inspect "$n" >/dev/null 2>&1 || { info "creating docker network '$n'"; docker network create "$n" >/dev/null; }
}

# envget <file> <KEY> [default]  - last KEY=value, surrounding quotes stripped
envget() {
  local v
  v="$(sed -n "s/^$2=//p" "$1" | tail -n1)"
  v="${v%\"}"; v="${v#\"}"; v="${v%\'}"; v="${v#\'}"
  echo "${v:-${3:-}}"
}

site_env() { local e="$SITES_DIR/$1/site.env"; [ -f "$e" ] || die "unknown site '$1' (missing $e)"; echo "$e"; }

dc() { # dc <site> <compose args...>
  # Without this, buildkit stamps a provenance attestation on every build, so an
  # unchanged rebuild still yields a new image id and compose recreates php+cron.
  export BUILDX_NO_DEFAULT_ATTESTATIONS=1
  local site="$1"; shift
  local env; env="$(site_env "$site")"
  local files=(-f "$STACK")
  [ "${PRM_HARDENED:-0}" = 1 ] && files+=(-f "$HARDENED")
  [ -f "$SITES_DIR/$site/compose.override.yaml" ] && files+=(-f "$SITES_DIR/$site/compose.override.yaml")
  local profiles; profiles="$(envget "$env" COMPOSE_PROFILES)"
  COMPOSE_PROFILES="$profiles" docker compose -p "$site" --env-file "$env" "${files[@]}" "$@"
}

prepare_site_dirs() { # the nested files mount needs its target to exist inside the ro app mount
  local site="$1" env dir files
  env="$(site_env "$site")"
  dir="$(envget "$env" SITE_DIR)"; files="$(envget "$env" FILES_PATH public/files)"
  mkdir -p "$dir/app/$files" "$dir/files" "$dir/backups"
  [ -f "$dir/php.ini" ] || : > "$dir/php.ini"
}

ensure_db() { # drush and deploy both talk to the database; starting it is not the caller's job
  dc "$1" up -d --build --wait db
}

random_secret() { openssl rand -base64 33 2>/dev/null | tr -d '\n=+/' | cut -c1-40 || head -c 30 /dev/urandom | base64 | tr -d '\n=+/'; }

cmd_new() {
  local site="${1:-}" domains="${2:-}"
  if [ -z "$site" ] || [ -z "$domains" ]; then die "usage: prm new <site> <domain[,domain]> [--type T] [--size S] [--example E]"; fi
  shift 2
  [[ "$site" =~ ^[a-z][a-z0-9-]{1,30}$ ]] || die "site name must match ^[a-z][a-z0-9-]{1,30}$"
  local type=generic size=small example=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --type) type="$2"; shift 2;;
      --size) size="$2"; shift 2;;
      --example) example="$2"; shift 2;;
      *) die "unknown option $1";;
    esac
  done
  local dir="$SITES_DIR/$site"
  [ ! -e "$dir/site.env" ] || die "site '$site' already exists"

  # On macOS/Windows the daemon lives in a VM that shares this directory as the invoking user,
  # so a root-owned 0700 secrets/ would be unreadable by it (and chown 33:33 below would stick).
  if [ "$(id -u)" = 0 ] && [ "$(uname -s)" != Linux ]; then
    die "don't run 'prm new' as root on $(uname -s): the docker VM shares your files as your user, so a root-owned secrets/ is unreadable by the daemon. Re-run without sudo."
  fi

  local docroot=public files=public/files profiles="" extra=""
  case "$type" in
    generic)  ;;
    drupal)   docroot=web; files=web/sites/default/files; profiles="cache,cron"
              extra=$'CRON_COMMAND=vendor/bin/drush cron\nCRON_INTERVAL=900\nDEPLOY_COMMAND=vendor/bin/drush deploy';;
    headless) docroot=backend/web; files=backend/web/sites/default/files; profiles="cache,cron,ws"
              extra=$'SPA_ROOT=frontend/dist\nCRON_COMMAND=vendor/bin/drush cron\nCRON_WORKDIR=/var/www/html/backend\nDEPLOY_COMMAND=cd backend && vendor/bin/drush deploy\nWS_DIR=ws-server';;
    spa)      files=files; extra="SPA_ROOT=dist";;
    *) die "unknown --type '$type' (generic|drupal|headless|spa)";;
  esac
  local sizing
  case "$size" in
    small)  sizing=$'DB_BUFFER_POOL=128M\nDB_MEM_LIMIT=384m\nPHP_FPM_MAX_CHILDREN=6\nPHP_MEM_LIMIT=640m';;
    medium) sizing=$'DB_BUFFER_POOL=384M\nDB_MEM_LIMIT=768m\nPHP_FPM_MAX_CHILDREN=12\nPHP_MEM_LIMIT=1280m';;
    large)  sizing=$'DB_BUFFER_POOL=1G\nDB_MEM_LIMIT=1536m\nPHP_FPM_MAX_CHILDREN=24\nPHP_MEM_LIMIT=2560m\nPHP_FPM_PM=dynamic';;
    *) die "unknown --size '$size' (small|medium|large)";;
  esac

  mkdir -p "$dir"/{app,files,secrets,backups}
  chmod 700 "$dir/secrets"
  random_secret > "$dir/secrets/db_password"
  random_secret > "$dir/secrets/db_root_password"
  chmod 644 "$dir/secrets/db_password"      # readable inside the container (dir is 0700 on the host)
  chmod 600 "$dir/secrets/db_root_password"
  : > "$dir/php.ini"

  {
    echo "# Generated by 'prm new'. Full reference of knobs: stack/site.env.example"
    echo "SITE_NAME=$site"
    echo "SITE_DIR=$dir"
    echo "APP_TYPE=$type"
    echo "DOCROOT=$docroot"
    echo "FILES_PATH=$files"
    echo "COMPOSE_PROFILES=$profiles"
    echo "$sizing"
    [ -z "$extra" ] || echo "$extra"
  } > "$dir/site.env"

  if [ -n "$example" ]; then
    [ -d "$ROOT/examples/$example/app" ] || die "no example '$example' with an app/ directory"
    cp -a "$ROOT/examples/$example/app/." "$dir/app/"
  fi
  mkdir -p "$dir/app/$files"
  # php-fpm runs as www-data (uid 33): it must be able to write uploads.
  if chown 33:33 "$dir/files" 2>/dev/null; then :; else
    chmod 0777 "$dir/files"
    info "could not chown files/ to uid 33; made it world-writable instead"
    info "expected off Linux, where the docker VM shares files as you; on Linux tighten it with:"
    info "  sudo chown -R 33:33 '$dir/files' && sudo chmod 755 '$dir/files'"
  fi

  local list="${domains//,/, }"
  mkdir -p "$EDGE_DIR/sites"
  cat > "$EDGE_DIR/sites/$site.caddy" <<EOF
$list {
	import common
	reverse_proxy $site-web:80
}
EOF
  info "site '$site' created in $dir"
  info "next: put your app in $dir/app, then: prm $site up && prm edge reload"
}

write_drupal_settings() { # <site dir> <domain[,domain...]> <written-by> [<settings dir under app/>]
  local dir="$1" domains="$2" by="$3" sub="${4:-web/sites/default}"
  local d="$dir/app/$sub" hosts="" h
  [ -f "$d/default.settings.php" ] || die "no $d/default.settings.php - is this a drupal docroot?"
  chmod u+w "$d" 2>/dev/null || true          # drupal hardens this dir to 0555
  [ -f "$d/settings.php" ] && chmod u+w "$d/settings.php"
  if [ -f "$d/settings.php" ]; then
    # php takes the last assignment, so appending overrides the old host's
    # database credentials, hash salt and trusted hosts, while keeping any
    # other settings the site had. The original is kept alongside.
    info "settings.php exists; appending the prm block (original kept as settings.php.pre-prm)"
    cp "$d/settings.php" "$d/settings.php.pre-prm"
  else
    cp "$d/default.settings.php" "$d/settings.php"
  fi
  for h in ${domains//,/ }; do hosts="$hosts'^${h//./\\.}\$', "; done
  mkdir -p "$dir/app/config/sync"
  cat >> "$d/settings.php" <<EOF

/**
 * Written by '$by'. Same shape as examples/drupal/README.md.
 */
\$databases['default']['default'] = [
  'driver' => 'mysql',
  'host' => getenv('DB_HOST'),
  'port' => getenv('DB_PORT'),
  'database' => getenv('DB_NAME'),
  'username' => getenv('DB_USER'),
  'password' => trim(file_get_contents(getenv('DB_PASSWORD_FILE'))),
  'prefix' => '',
  'collation' => 'utf8mb4_general_ci',
  'init_commands' => ['isolation_level' => 'SET SESSION TRANSACTION ISOLATION LEVEL READ COMMITTED'],
];
\$settings['hash_salt'] = getenv('DRUPAL_HASH_SALT');
\$settings['trusted_host_patterns'] = [${hosts%, }];
\$settings['config_sync_directory'] = '../config/sync';
// TLS is terminated at the shared Caddy edge.
\$settings['reverse_proxy'] = TRUE;
\$settings['reverse_proxy_addresses'] = [\$_SERVER['REMOTE_ADDR'] ?? ''];
EOF
}

cmd_demo() { # one command from nothing to a working Drupal site, for kicking the tyres
  local site="${1:-}"
  [ -n "$site" ] || die "usage: prm demo <name>   (serves it on <name>.localhost)"
  [ $# -le 1 ] || die "prm demo takes a single name; the domain is always <name>.localhost"
  local domain="$site.localhost" dir="$SITES_DIR/$site"

  cmd_new "$site" "$domain" --type drupal
  printf 'DRUPAL_HASH_SALT=%s\n' "$(random_secret)" >> "$dir/site.env"

  # create-project refuses a non-empty target and the uploads mount keeps
  # /var/www/html non-empty, so build in /tmp and copy the contents up.
  info "scaffolding drupal (first run downloads a few hundred MB, later runs reuse the composer cache)"
  # composer output is left unquieted on purpose: this is the slow step, and silence
  # for a minute looks like a hang.
  dc "$site" run --rm -T --build tools sh -c '
    set -e
    echo "==> composer create-project drupal/recommended-project" >&2
    composer create-project drupal/recommended-project /tmp/new --no-interaction
    echo "==> composer require drush/drush" >&2
    cd /tmp/new && composer require --no-interaction drush/drush
    echo "==> copying the project into the site directory (a few thousand files)" >&2
    cp -R /tmp/new/. /var/www/html/   # -R not -a: preserving times across the mount can fail
    echo "==> scaffold complete" >&2
  '

  info "writing settings.php"
  write_drupal_settings "$dir" "$domain" "prm demo"

  info "installing drupal"
  ensure_db "$site"
  dc "$site" run --rm -T -w /var/www/html tools vendor/bin/drush site:install standard -y \
    --account-name=admin --account-pass="$DEMO_PASS" --site-name="$site" >&2

  cmd_site "$site" up --wait
  if docker compose -p prm-edge -f "$EDGE_DIR/compose.yaml" ps -q caddy 2>/dev/null | grep -q .; then
    cmd_edge reload
  else
    info "the edge is not running; start it with: prm edge up"
  fi

  info "demo site ready: https://$domain/  (admin / $DEMO_PASS)"
  info "the certificate is from caddy's internal CA, so curl needs -k"
  info "remove it with:"
  info "  prm $site down -v && docker volume rm ${site}_composer_cache"
  info "  chmod -R u+w $dir && rm -rf $dir $EDGE_DIR/sites/$site.caddy && prm edge reload"
}

site_names() { # every site with a site.env, one per line
  local d
  [ -d "$SITES_DIR" ] || return 0
  for d in "$SITES_DIR"/*/; do
    [ -f "${d}site.env" ] && basename "$d"
  done
}

cmd_all() { # run one site command against every site, without stopping at the first failure
  [ $# -gt 0 ] || die "usage: prm all <command> [args...]   (e.g. prm all up)"
  local site rc=0 failed=""
  for site in $(site_names); do
    info "--- $site: $* ---"
    if cmd_site "$site" "$@"; then :; else rc=1; failed="$failed $site"; fi
  done
  [ -n "$failed" ] && info "failed:$failed"
  return $rc
}

cmd_update() { # pull new base images, rebuild, restart every site, then prove what is running
  local site rc=0 failed="" running
  for site in $(site_names); do
    info "--- $site ---"
    if dc "$site" build --pull && dc "$site" up -d --remove-orphans; then :; else
      rc=1; failed="$failed $site"; continue
    fi
  done
  [ -n "$failed" ] && info "failed:$failed"
  info "--- versions now running ---"
  for site in $(site_names); do
    running="$(dc "$site" exec -T php php -r 'echo PHP_VERSION;' 2>/dev/null)" || running="(php not running)"
    printf '%-20s php %s\n' "$site" "$running"
  done
  return $rc
}

cmd_migrate() { # lift one site out of an existing (multi)site onto this host
  local site="${1:-}" domains="${2:-}" code="" db="" files="" size=small
  if [ -z "$site" ] || [ -z "$domains" ]; then
    die "usage: prm migrate <site> <domain[,domain]> --code <dir> --db <dump.sql[.gz]> [--files <dir>] [--size S]"
  fi
  shift 2
  while [ $# -gt 0 ]; do
    case "$1" in
      --code)  code="$2"; shift 2;;
      --db)    db="$2"; shift 2;;
      --files) files="$2"; shift 2;;
      --size)  size="$2"; shift 2;;
      *) die "unknown option $1";;
    esac
  done
  [ -n "$code" ] || die "--code <dir> is required (the drupal codebase to copy in)"
  [ -d "$code" ] || die "--code: no such directory: $code"
  [ -n "$db" ]   || die "--db <dump.sql[.gz]> is required"
  [ -f "$db" ]   || die "--db: no such file: $db"
  [ -z "$files" ] || [ -d "$files" ] || die "--files: no such directory: $files"

  # Where is the docroot? A multisite is usually the web/ layout, but older ones
  # put the docroot at the repo root, which serves vendor/ over HTTP.
  local docroot=web filespath=web/sites/default/files
  if [ -f "$code/web/index.php" ]; then :
  elif [ -f "$code/index.php" ]; then
    docroot=. ; filespath=sites/default/files
    info "WARNING: docroot is the project root (legacy drupal/drupal layout)."
    info "  vendor/ and composer.json will be served over HTTP. Restructure to the"
    info "  web/ layout (drupal/recommended-project) before this faces the internet."
  else
    die "--code: no index.php at $code/web/ or $code/ - is that a drupal codebase?"
  fi

  local dir="$SITES_DIR/$site"
  cmd_new "$site" "$domains" --type drupal --size "$size"
  if [ "$docroot" != web ]; then
    sed -i.bak "s|^DOCROOT=.*|DOCROOT=$docroot|; s|^FILES_PATH=.*|FILES_PATH=$filespath|" "$dir/site.env"
    rm -f "$dir/site.env.bak"
  fi
  printf 'DRUPAL_HASH_SALT=%s\n' "$(random_secret)" >> "$dir/site.env"

  info "copying the codebase from $code"
  cp -R "$code/." "$dir/app/"
  chmod -R u+w "$dir/app"   # a live drupal tree arrives with 0555 dirs and 0444 settings

  if [ -n "$files" ]; then
    info "copying uploads from $files"
    cp -R "$files/." "$dir/files/"
    chmod -R u+w "$dir/files"
  fi

  info "writing settings.php"
  write_drupal_settings "$dir" "$domains" "prm migrate" "$(dirname "$filespath")"

  info "restoring the database"
  ensure_db "$site"
  PRM_YES=1 cmd_restore "$site" "$db"

  cmd_site "$site" up --wait
  cmd_edge reload

  info "migrated '$site' -> https://${domains%%,*}/"
  info "the database came from another host, so finish with:"
  info "  prm $site deploy      # drush updatedb, config:import, cache rebuild"
  info "left in place for you to review: any web/sites/<name>/ from the old multisite"
}

cmd_ls() {
  [ -d "$SITES_DIR" ] || exit 0
  local d n host url
  for d in "$SITES_DIR"/*/; do
    [ -f "${d}site.env" ] || continue
    n="$(basename "$d")"
    # first hostname of the site's caddy snippet, as a URL terminals can click
    host="$(grep -m1 -o '^[^ ,{]*' "$EDGE_DIR/sites/$n.caddy" 2>/dev/null)" || host=""
    if [ -n "$host" ]; then url="https://$host/"; else url="-"; fi
    printf '%-20s %-10s %s\n' "$n" "$(envget "${d}site.env" APP_TYPE)" "$url"
  done
}

cmd_edge() {
  local sub="${1:-}"; shift || true
  [ -f "$EDGE_DIR/.env" ] || die "create $EDGE_DIR/.env first (cp edge/.env.example edge/.env)"
  ensure_network
  local ec=(docker compose -p prm-edge --env-file "$EDGE_DIR/.env" -f "$EDGE_DIR/compose.yaml")
  case "$sub" in
    up)     "${ec[@]}" up -d;;
    down)   "${ec[@]}" down;;
    reload) "${ec[@]}" exec -w /etc/caddy caddy caddy reload --config /etc/caddy/Caddyfile;;
    logs|ps|restart) "${ec[@]}" "$sub" "$@";;
    *) die "usage: prm edge up|down|reload|logs|ps|restart";;
  esac
}

cmd_backup() {
  local site="$1" env dir ts keep kind
  env="$(site_env "$site")"; dir="$(envget "$env" SITE_DIR)"
  keep="${PRM_BACKUP_KEEP:-14}"; ts="$(date -u +%Y%m%dT%H%M%SZ)"
  mkdir -p "$dir/backups"
  info "dumping database"
  # single quotes are intentional: the command substitution must run inside the container
  # shellcheck disable=SC2016
  dc "$site" exec -T db sh -c 'MYSQL_PWD="$(cat /run/secrets/db_root_password)" exec mariadb-dump --single-transaction --quick --routines --events --triggers -uroot "$MARIADB_DATABASE"' \
    | gzip -9 > "$dir/backups/db-$ts.sql.gz"
  info "archiving uploads"
  tar -C "$dir" -czf "$dir/backups/files-$ts.tar.gz" files
  # keep the newest N of each kind
  for kind in 'db-*.sql.gz' 'files-*.tar.gz'; do
    # shellcheck disable=SC2012,SC2086
    ls -1t "$dir"/backups/$kind 2>/dev/null | tail -n +$((keep + 1)) | xargs -r rm --
  done
  info "backup written: $dir/backups/*-$ts.*"
  # optional offsite hook, e.g. PRM_BACKUP_HOOK=/opt/prometheus/hooks/rclone-push.sh
  if [ -n "${PRM_BACKUP_HOOK:-}" ]; then "$PRM_BACKUP_HOOK" "$site" "$dir/backups"; fi
}

cmd_restore() {
  local site="$1" file="${2:-}" ans
  [ -f "$file" ] || die "usage: prm <site> restore <db-....sql.gz>"
  if [ "${PRM_YES:-0}" != 1 ]; then
    read -r -p "This REPLACES the database of '$site' with $file. Type the site name to continue: " ans
    [ "$ans" = "$site" ] || die "aborted"
  fi
  # a dump exported from a legacy host is as often plain .sql as gzipped.
  # gunzip -c, not zcat: BSD zcat looks for "$file".Z and fails on macOS.
  # shellcheck disable=SC2016
  { if gzip -t "$file" 2>/dev/null; then gunzip -c "$file"; else cat "$file"; fi; } \
    | dc "$site" exec -T db sh -c 'MYSQL_PWD="$(cat /run/secrets/db_root_password)" exec mariadb -uroot "$MARIADB_DATABASE"'
  info "database restored from $file"
}

cmd_site() {
  local site="$1" sub="${2:-}"; shift 2 || shift 1
  site_env "$site" >/dev/null
  ensure_network
  prepare_site_dirs "$site"
  case "$sub" in
    up)      dc "$site" up -d --build "$@";;
    down)    dc "$site" down "$@";;
    restart) dc "$site" restart "$@";;
    ps|logs|build|config|top|stats) dc "$site" "$sub" "$@";;
    # php/cron are built here, not published: asking a registry for prm/php fails
    pull)    dc "$site" pull --ignore-buildable "$@";;
    exec)    dc "$site" exec "$@";;
    sh)      dc "$site" exec php bash;;
    compose) dc "$site" "$@";;
    composer) dc "$site" run --rm tools composer "$@";;
    drush)   ensure_db "$site"; dc "$site" run --rm -w "${PRM_WORKDIR:-/var/www/html}" tools vendor/bin/drush "$@";;
    npm|npx|node) dc "$site" run --rm node "$sub" "$@";;
    deploy)
      local cmd; cmd="$(envget "$(site_env "$site")" DEPLOY_COMMAND)"
      ensure_db "$site"
      if [ -n "$cmd" ]; then info "running deploy command: $cmd"; dc "$site" run --rm tools sh -c "$cmd"; fi
      dc "$site" up -d --build --remove-orphans
      dc "$site" restart php   # clears opcache when PHP_OPCACHE_VALIDATE=0
      ;;
    backup)  cmd_backup "$site";;
    restore) cmd_restore "$site" "$@";;
    *) die "unknown command '$sub'. Try: up down restart ps logs deploy backup restore sh exec composer drush npm compose";;
  esac
}

case "${1:-}" in
  ""|-h|--help|help) awk 'NR>1 && /^#/ {sub(/^# ?/, ""); print; next} NR>1 {exit}' "${BASH_SOURCE[0]}";;
  new)  shift; cmd_new "$@";;
  demo) shift; cmd_demo "$@";;
  all)  shift; cmd_all "$@";;
  migrate) shift; cmd_migrate "$@";;
  update) cmd_update;;
  ls)   cmd_ls;;
  edge) shift; cmd_edge "$@";;
  *)    site="$1"; shift; cmd_site "$site" "$@";;
esac
