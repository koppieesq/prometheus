fastcgi_cache ${MICROCACHE_ZONE};
fastcgi_cache_key "$scheme$request_method$host$request_uri";
fastcgi_cache_valid 200 301 ${MICROCACHE_TTL};
fastcgi_cache_bypass $prm_skip_cache;
fastcgi_no_cache $prm_skip_cache;
fastcgi_cache_lock on;
fastcgi_cache_use_stale updating error timeout http_500 http_503;
add_header X-Micro-Cache $upstream_cache_status;
