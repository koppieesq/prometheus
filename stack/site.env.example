# Full reference of per-site knobs. `prm new` writes a compact sites/<name>/site.env
# with the essentials; add anything below to override defaults.
# Values are plain KEY=VALUE (no shell syntax). Quote values containing spaces.

# --- identity (written by prm new) ---
SITE_NAME=blog
SITE_DIR=/srv/prm/sites/blog
APP_TYPE=generic            # generic | drupal | headless | spa
COMPOSE_PROFILES=           # cache,cron,ws

# --- layout (paths are relative to the app dir) ---
DOCROOT=public
SPA_ROOT=dist               # headless/spa: built frontend dir
FILES_PATH=public/files     # the one writable, persistent upload dir

# --- versions ---
PHP_VERSION=8.4
MARIADB_VERSION=11.8
NGINX_VERSION=1.28
NODE_VERSION=22

# --- PHP / FPM ---
PHP_MEMORY_LIMIT=256M
PHP_UPLOAD_MAX=32M
PHP_OPCACHE_VALIDATE=0      # 0 = fastest; run `prm <site> restart php` after deploys
PHP_FPM_PM=ondemand         # ondemand frees RAM for idle sites; use dynamic/static for busy ones
PHP_FPM_MAX_CHILDREN=6      # ~ PHP_MEM_LIMIT / ~100MB per Drupal worker
PHP_MEM_LIMIT=640m

# --- MariaDB ---
DB_NAME=app
DB_USER=app
DB_BUFFER_POOL=128M
DB_MEM_LIMIT=384m
DB_MAX_CONNECTIONS=60

# --- nginx ---
MICROCACHE_ZONE=micro       # "off" disables the anonymous-GET microcache
MICROCACHE_TTL=5s
WEB_MEM_LIMIT=96m

# --- cron profile ---
CRON_COMMAND=true
CRON_INTERVAL=900
CRON_WORKDIR=/var/www/html

# --- ws profile ---
WS_DIR=ws-server
WS_COMMAND=node server.js

# --- deploy hook run by `prm <site> deploy` ---
DEPLOY_COMMAND=
